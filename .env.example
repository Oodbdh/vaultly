# ── Supabase ────────────────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ── AI receipt analysis (OCR) ───────────────────────────────────────────────
# Runs server-side in the analyze-receipt Edge Function. The OpenAI key is a
# Supabase secret, NOT an env var here:
#   supabase secrets set OPENAI_API_KEY=sk-...
# Never add an OpenAI key to this file — EXPO_PUBLIC_ values ship in the bundle.
#
# Blank = Edge Function (default). `gemini` = legacy direct client call.
EXPO_PUBLIC_AI_PROVIDER=

EXPO_PUBLIC_GEMINI_API_KEY=AIza...
EXPO_PUBLIC_GEMINI_MODEL=gemini-2.0-flash

# ── RevenueCat ──────────────────────────────────────────────────────────────
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxxxxxx

# ── AdMob ───────────────────────────────────────────────────────────────────
EXPO_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-0000000000000000~0000000000
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-0000000000000000~0000000000
EXPO_PUBLIC_ADMOB_REWARDED_IOS=ca-app-pub-0000000000000000/0000000000
EXPO_PUBLIC_ADMOB_REWARDED_ANDROID=ca-app-pub-0000000000000000/0000000000

EAS_PROJECT_ID=
