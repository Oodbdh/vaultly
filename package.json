{
  "name": "vaultly",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "db:check": "node scripts/check-supabase.mjs",
    "db:smoke": "node scripts/smoke-supabase.mjs",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --linked > src/lib/database.generated.ts",
    "fn:check": "node scripts/check-function.mjs",
    "fn:deploy": "supabase functions deploy analyze-receipt --use-api",
    "fn:logs": "supabase functions logs analyze-receipt"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.45.4",
    "@tanstack/react-query": "^5.59.0",
    "expo": "^54.0.36",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.9",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.19",
    "expo-web-browser": "~15.0.11",
    "i18next": "^23.15.1",
    "react": "19.1.0",
    "react-i18next": "^15.0.2",
    "react-native": "0.81.5",
    "react-native-google-mobile-ads": "^15.8.3",
    "react-native-purchases": "^8.2.2",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "zustand": "^4.5.5"
  },
  "overrides": {
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.10",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "~54.0.10",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~10.0.0",
    "supabase": "^2.110.0",
    "typescript": "~5.9.2"
  }
